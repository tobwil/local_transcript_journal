{
  "name": "meeting-journal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Lokale Browser- und macOS-Desktop-Anwendung für Transkripte, Workshop-Aufnahmen und Recaps",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "desktop:dev": "ELECTRON_DEV=1 electron .",
    "test": "node --test test/*.test.js",
    "test:all": "npm test && npm run test:electron",
    "test:electron": "node test/electron-smoke.mjs",
    "test:packaged": "TEST_PACKAGED=1 node test/electron-smoke.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fugood/whisper.node": "1.1.1",
    "ffmpeg-static": "5.3.0",
    "mammoth": "^1.12.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.61.1"
  },
  "build": {
    "appId": "de.tobwil.workshopjournal",
    "productName": "Workshop Journal",
    "asar": true,
    "asarUnpack": [
      "node_modules/@fugood/whisper.node/**/*",
      "node_modules/@fugood/node-whisper-*/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "files": [
      "electron/**/*",
      "lib/**/*",
      "public/**/*",
      "server.js",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "icon": "assets/icon.svg",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Workshop Journal benötigt das Mikrofon, um Beiträge im Workshop lokal aufzuzeichnen.",
        "NSAudioCaptureUsageDescription": "Workshop Journal benötigt Zugriff auf Systemaudio, um Remote-Teilnehmende lokal aufzuzeichnen."
      }
    },
    "dmg": {
      "title": "Workshop Journal ${version}"
    }
  }
}
